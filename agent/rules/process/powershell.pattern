#===================================================================================

- name: PS/cmd child process
  description: Launching a cmd or powershell child process.
    Typical for lower-quality C2 implants.  
  category: [helper, c2, lineage]
  author: emryll
  score_parent: true
  score: 40

  components:
  - type: process
    conditions:
      path: [powershell.exe, pwsh.exe, cmd.exe]
      is_child: true # the real explorer.exe is not counted as a parent

  response: isolate family and alert(message: "Suspicious shell child process!")

#===================================================================================
