  author: emryll
  score: 65

  universal_conditions:
    path_not:
      - "%programfiles%/Opera/Application/opera.exe"
      - "%localappdata%/Programs/Opera/Application/opera.exe" # default install location, unfortunately
    is_signed: true

  components:
    - type: file
      action: read
      conditions:
        dir:
          - "%appdata%/Roaming/Opera Software/Opera Stable"

