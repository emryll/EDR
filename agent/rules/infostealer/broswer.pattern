#=================================================================================================

- title: Firefox Database access
  description: Read Firefox's browser database on disk, which contains saved passwords,
    cookies, browser history, etc. Very commonly done by infostealer malware. High confidence pattern.
  category: [ infostealer, browser ]
  author: emryll
  score: 65

  universal_conditions:
    path_not: [ "%programfiles%/Mozilla Firefox/firefox.exe" ]
    is_signed: true

  components:
    - type: file
      action: read
      conditions:
        dir:
          - "%appdata%/Roaming/Mozilla/Firefox/Profiles"

  response: isolate and alert

#=================================================================================================

- title: Google Chrome Database access
